<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.haven.relay</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>haven.relay_server</string>
        <string>--port</string>
        <string>8443</string>
        <!-- --ws-port enables the WebSocket transport the web client (webapp/)
             needs; drop it (or use --ws-port 0) if you only need desktop clients. -->
        <string>--ws-port</string>
        <string>8444</string>
        <string>--db</string>
        <!-- Adjust this path to wherever you cloned Haven -->
        <string>/Users/YOURNAME/Developer/haven/relay.db</string>
        <!-- Only needed for a Tailscale Funnel deployment (see
             WEB_DEPLOYMENT.md's Option C1) — the relay must terminate its
             own TLS there rather than relying on Funnel to do it, or real
             browsers' WebSocket connections fail. Get the cert with
             `tailscale cert`; omit these two flags entirely for Option A/B
             (a reverse proxy like Caddy/nginx handles TLS there instead). -->
        <string>--tls-cert</string>
        <string>/Users/YOURNAME/Library/Application Support/Haven/tls/haven.crt</string>
        <string>--tls-key</string>
        <string>/Users/YOURNAME/Library/Application Support/Haven/tls/haven.key</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/YOURNAME/Developer/haven</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/haven-relay.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/haven-relay.err</string>
</dict>
</plist>
