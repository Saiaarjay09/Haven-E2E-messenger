<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.haven.static</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <!-- webapp.serve_static, NOT plain http.server — it sets the
             security headers (CSP, HSTS, etc.) the stock server
             doesn't. Edit CSP_CONNECT_HOST at the top of
             webapp/serve_static.py first if you're deploying under a
             different domain than this repo's default, or the page's
             own CSP will block it from reaching your accounts
             server/relay. -->
        <string>webapp.serve_static</string>
        <string>8899</string>
        <string>--bind</string>
        <string>127.0.0.1</string>
        <!-- Adjust this path to wherever you cloned Haven -->
        <string>--directory</string>
        <string>/Users/YOURNAME/Developer/haven/webapp/static</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/YOURNAME/Developer/haven</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/haven-static.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/haven-static.err</string>
</dict>
</plist>
