<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.haven.accounts</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>webapp.accounts_server:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>
    <!-- Adjust this path to wherever you cloned Haven -->
    <key>WorkingDirectory</key>
    <string>/Users/YOURNAME/Developer/haven</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HAVEN_ACCOUNTS_DB</key>
        <string>/Users/YOURNAME/Library/Application Support/Haven/haven_accounts.db</string>
        <!-- Optional: enables live call translation (/api/translate). Leave
             out entirely to skip the feature — it degrades gracefully with
             an HTTP 503 when unset. Get a key from platform.openai.com,
             and never put it anywhere client-side (see translation.js) or
             commit it to this file. -->
        <key>HAVEN_OPENAI_API_KEY</key>
        <string>sk-YOUR-OPENAI-KEY-HERE</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/haven-accounts.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/haven-accounts.err</string>
</dict>
</plist>
